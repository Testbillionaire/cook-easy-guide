# Copy to .env for local dev. Never commit .env — it is gitignored.
# In production set these in your host's environment settings (e.g. Vercel
# Project Settings > Environment Variables), not in a file.

# --- Client (inlined into the JS bundle at BUILD time) ---
# Vite only exposes VITE_-prefixed vars to browser code, which is why these
# duplicate the server vars below. They must be present when `vite build`
# runs, not just at runtime. The publishable/anon key is public by design
# and ships in the browser bundle; Row Level Security, not secrecy, is what
# protects your data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server (read at runtime via process.env) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NOTE: SUPABASE_PROJECT_ID / VITE_SUPABASE_PROJECT_ID were set by Lovable but
# are read by no code in this repo. The Supabase CLI takes the project ref from
# supabase/config.toml instead. Safe to omit.

# SECRET. Bypasses Row Level Security entirely — never prefix it with VITE_
# and never expose it to the client. Required by supabaseAdmin in
# src/integrations/supabase/client.server.ts. Without it the admin pages,
# recipe curation overlays, saved-profile and analytics/trending server
# functions all fail — and they fail SILENTLY, degrading to empty results
# rather than surfacing an error.
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email (Phase 3) ---
# Currently satisfied by Lovable's hosted send service. Replace with your own
# provider (Resend/Postmark/SES) when migrating off Lovable.
# LOVABLE_API_KEY=
# LOVABLE_SEND_URL=
